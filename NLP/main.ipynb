

"""
Kaggle "NLP Getting Started" (Disaster Tweets) - версия 3 (под максимум на лидерборде).

Что нового относительно v2:
  1. Большие модели: roberta-large (+ опционально deberta-v3-large).
  2. Починка DeBERTa: веса приводятся к float32 (ошибка "unscale FP16 gradients").
  3. Чистка шумных меток: первый быстрый проход находит строки train, где ответ модели
     уверенно спорит с меткой (по умолчанию 3%), и они удаляются из обучения.
  4. Защита от "схлопывания" большой модели: если фолд обучился плохо - повтор с другим зерном.
  5. Несколько зёрен (SEEDS=2..3) - усреднение по ним.
  6. Для тестовых твитов, у которых в train есть такой же текст с единой меткой,
     берётся метка из train (флаг OVERRIDE_DUP).
  7. Стекинг / взвешенное среднее и порог под F1 - как в v2.

Настройки через переменные окружения (необязательно):
    MODELS=roberta-large,microsoft/deberta-v3-base,cardiffnlp/twitter-roberta-base,roberta-base
    SEEDS=1          (лучше 2-3, но дольше)
    FOLDS=5
    CLEAN_FRAC=0.03  (доля удаляемых шумных строк, 0 - выключить)
    NOISE_MODEL=roberta-base
    OVERRIDE_DUP=1
    MODE=finetune|features
Нужны: GPU (Settings -> Accelerator), Internet = On.
"""

import gc
import html
import os
import random
import re
import time
from urllib.parse import unquote

import numpy as np
import pandas as pd
from scipy.sparse import hstack
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import accuracy_score, f1_score
from sklearn.model_selection import StratifiedGroupKFold, StratifiedKFold, cross_val_predict

# ----------------------------------------------------------------------------
# 0. Настройки
# ----------------------------------------------------------------------------
SEED = 42
N_FOLDS = int(os.environ.get("FOLDS", 5))
N_SEEDS = int(os.environ.get("SEEDS", 3))
MODELS = os.environ.get(
    "MODELS",
    "roberta-large,microsoft/deberta-v3-base,cardiffnlp/twitter-roberta-base,roberta-base",
).split(",")
CLEAN_FRAC = float(os.environ.get("CLEAN_FRAC", 0.03))
NOISE_MODEL = os.environ.get("NOISE_MODEL", "roberta-base")
OVERRIDE_DUP = os.environ.get("OVERRIDE_DUP", "1") == "1"

REMOVE_TRAIN_ROWS_SEEN_IN_TEST = False
FEATURES_MODEL = "distilbert-base-cased"
MAX_LEN = 96
FT_EPOCHS = 3
LABEL_SMOOTHING = 0.1
MODEL_CFG = {
    "roberta-large": dict(lr=1e-5, bs=16),
    "microsoft/deberta-v3-large": dict(lr=1e-5, bs=16),
    "microsoft/deberta-v3-base": dict(lr=2e-5, bs=32),
    "roberta-base": dict(lr=2e-5, bs=32),
    "cardiffnlp/twitter-roberta-base": dict(lr=2e-5, bs=32),
}
DEFAULT_CFG = dict(lr=3e-5, bs=32)
MIN_FOLD_F1 = 0.70          # ниже этого фолд считается "схлопнувшимся" и обучается заново

DUP_MAP = {}                # нормализованный текст -> метка (если все копии в train согласны)


def set_seed(seed: int = SEED) -> None:
    random.seed(seed)
    np.random.seed(seed)
    os.environ["PYTHONHASHSEED"] = str(seed)
    try:
        import torch
        torch.manual_seed(seed)
        torch.cuda.manual_seed_all(seed)
    except ImportError:
        pass


set_seed()


class FoldSplitter:
    """Стратифицированные фолды с группами: похожие твиты - в одном фолде."""
    groups = None

    def split(self, X, y):
        sgkf = StratifiedGroupKFold(n_splits=N_FOLDS, shuffle=True, random_state=SEED)
        return sgkf.split(np.zeros(len(y)), y, groups=self.groups)


SPLITTER = FoldSplitter()


# ----------------------------------------------------------------------------
# 1. Данные
# ----------------------------------------------------------------------------
def find_data_dir() -> str:
    env_dir = os.environ.get("DATA_DIR")
    if env_dir and os.path.exists(os.path.join(env_dir, "train.csv")):
        return env_dir
    for path in ["/kaggle/input/nlp-getting-started", "./data", "."]:
        if os.path.exists(os.path.join(path, "train.csv")):
            return path
    for root, _d, files in os.walk("/kaggle/input"):
        if "train.csv" in files and "test.csv" in files:
            print(f"Данные найдены в: {root}")
            return root
    raise FileNotFoundError("Не найден train.csv. Задайте DATA_DIR.")


def load_data():
    d = find_data_dir()
    train = pd.read_csv(os.path.join(d, "train.csv"))
    test = pd.read_csv(os.path.join(d, "test.csv"))
    print(f"Train: {train.shape}, Test: {test.shape}")
    return train, test


def normalize_for_dedup(text) -> str:
    text = html.unescape(str(text)).lower()
    text = re.sub(r"https?://\S+|www\.\S+", " ", text)
    text = re.sub(r"[^a-z0-9\s]", " ", text)
    return re.sub(r"\s+", " ", text).strip()


def remove_duplicates_and_leakage(train, test):
    """Схлопываем дубликаты внутри train; запоминаем однозначные метки для DUP_MAP."""
    global DUP_MAP
    train = train.copy()
    train["_key"] = train["text"].map(normalize_for_dedup)
    test_keys = set(test["text"].map(normalize_for_dedup))

    n_before = len(train)
    mean_target = train.groupby("_key")["target"].mean()
    DUP_MAP = mean_target[mean_target.isin([0.0, 1.0])].to_dict()

    keep = train.drop_duplicates("_key", keep="first").copy()
    keep["target"] = keep["_key"].map(mean_target)
    keep = keep[keep["target"] != 0.5]
    keep["target"] = (keep["target"] > 0.5).astype(int)
    keep["group"] = keep["_key"].map(lambda s: " ".join(s.split()[:6]))
    print(f"Дубликаты внутри train: {n_before} -> {len(keep)} строк")

    overlap = keep["_key"].isin(test_keys)
    print(f"Твитов train, которые есть и в test: {overlap.sum()}")
    if REMOVE_TRAIN_ROWS_SEEN_IN_TEST:
        keep = keep[~overlap]
    return keep.drop(columns="_key").reset_index(drop=True)


def clean_keyword(s: pd.Series) -> pd.Series:
    return s.fillna("none").astype(str).map(unquote).str.lower().str.strip()


def prepare_tabular_features(df):
    df = df.copy()
    df["keyword"] = clean_keyword(df["keyword"])
    return df.drop(columns=["location"], errors="ignore")


# ----------------------------------------------------------------------------
# 2. Очистка текста
# ----------------------------------------------------------------------------
URL_RE = re.compile(r"https?://\S+|www\.\S+")
MENTION_RE = re.compile(r"@\w+")

try:
    import emoji as _emoji
except ImportError:
    _emoji = None


def demojize(text: str) -> str:
    if _emoji is None:
        return text
    return _emoji.demojize(text, delimiters=(" ", " ")).replace("_", " ")


def clean_text_minimal(text):
    text = URL_RE.sub(" ", demojize(html.unescape(str(text))))
    return re.sub(r"\s+", " ", text).strip()


def clean_text_basic(text):
    text = URL_RE.sub(" ", demojize(html.unescape(str(text))).lower())
    text = MENTION_RE.sub(" ", text).replace("#", " ")
    text = re.sub(r"[^a-z0-9\s]", " ", text)
    return re.sub(r"\s+", " ", text).strip()


# ----------------------------------------------------------------------------
# 3. Метрики
# ----------------------------------------------------------------------------
def find_best_threshold(y_true, probs):
    grid = np.arange(0.20, 0.80, 0.01)
    scores = [f1_score(y_true, (probs >= t).astype(int)) for t in grid]
    i = int(np.argmax(scores))
    return float(grid[i]), float(scores[i])


def report(name, y, oof):
    t, f1 = find_best_threshold(y, oof)
    acc = accuracy_score(y, (oof >= t).astype(int))
    print(f">>> {name}: порог {t:.2f} | F1 = {f1:.4f} | accuracy = {acc:.4f}", flush=True)
    return t, f1


# ----------------------------------------------------------------------------
# 4. Базовая модель
# ----------------------------------------------------------------------------
def run_baseline(train, test, y):
    oof = np.zeros(len(train))
    test_pred = np.zeros(len(test))
    for fold, (tr, va) in enumerate(SPLITTER.split(train, y)):
        word = TfidfVectorizer(ngram_range=(1, 2), min_df=2, sublinear_tf=True)
        char = TfidfVectorizer(analyzer="char_wb", ngram_range=(2, 5), min_df=3,
                               sublinear_tf=True, max_features=200_000)
        kw = TfidfVectorizer(analyzer=lambda s: [s])

        def fit_transform(df):
            return hstack([word.fit_transform(df["text_basic"]),
                           char.fit_transform(df["text_basic"]),
                           kw.fit_transform(df["keyword"])]).tocsr()

        def transform(df):
            return hstack([word.transform(df["text_basic"]),
                           char.transform(df["text_basic"]),
                           kw.transform(df["keyword"])]).tocsr()

        x_tr = fit_transform(train.iloc[tr])
        clf = LogisticRegression(C=3.0, max_iter=3000, class_weight="balanced", random_state=SEED)
        clf.fit(x_tr, y[tr])
        oof[va] = clf.predict_proba(transform(train.iloc[va]))[:, 1]
        test_pred += clf.predict_proba(transform(test))[:, 1] / N_FOLDS
        print(f"  [baseline] fold {fold + 1}: F1@0.5 = "
              f"{f1_score(y[va], (oof[va] >= 0.5).astype(int)):.4f}")
    return oof, test_pred


# ----------------------------------------------------------------------------
# 5. Трансформеры
# ----------------------------------------------------------------------------
def bert_input(df):
    return df["keyword"].tolist(), df["text_min"].tolist()


def extract_embeddings(df, device):
    import torch
    from transformers import AutoModel, AutoTokenizer

    tok = AutoTokenizer.from_pretrained(FEATURES_MODEL)
    model = AutoModel.from_pretrained(FEATURES_MODEL).float().to(device).eval()
    kws, texts = bert_input(df)
    out = []
    with torch.no_grad():
        for i in range(0, len(texts), 64):
            enc = tok(kws[i:i + 64], texts[i:i + 64], truncation=True,
                      max_length=MAX_LEN, padding=True, return_tensors="pt").to(device)
            hidden = model(**enc).last_hidden_state
            mask = enc["attention_mask"].unsqueeze(-1).float()
            out.append(((hidden * mask).sum(1) / mask.sum(1)).cpu().numpy())
    return np.vstack(out)


def run_bert_features(train, test, y):
    import torch
    device = "cuda" if torch.cuda.is_available() else "cpu"
    print(f"  Извлекаем признаки {FEATURES_MODEL} на {device}...")
    x_all = extract_embeddings(train, device)
    x_te = extract_embeddings(test, device)
    oof = np.zeros(len(train))
    test_pred = np.zeros(len(test))
    for fold, (tr, va) in enumerate(SPLITTER.split(x_all, y)):
        clf = LogisticRegression(C=1.0, max_iter=3000, random_state=SEED)
        clf.fit(x_all[tr], y[tr])
        oof[va] = clf.predict_proba(x_all[va])[:, 1]
        test_pred += clf.predict_proba(x_te)[:, 1] / N_FOLDS
        print(f"  [bert-features] fold {fold + 1}: F1@0.5 = "
              f"{f1_score(y[va], (oof[va] >= 0.5).astype(int)):.4f}")
    return oof, test_pred


def _predict_proba(model, loader, device, use_amp):
    import torch
    model.eval()
    probs = []
    with torch.no_grad():
        for batch in loader:
            batch = {k: v.to(device) for k, v in batch.items() if k != "labels"}
            with torch.autocast(device_type="cuda", dtype=torch.float16, enabled=use_amp):
                logits = model(**batch).logits
            probs.append(torch.softmax(logits.float(), dim=-1)[:, 1].cpu().numpy())
    return np.concatenate(probs)


def run_finetune(model_name, train, test, y, seed):
    """Дообучение модели по фолдам. Возвращает OOF и усреднённый прогноз на тест."""
    import torch
    from torch.utils.data import DataLoader
    from transformers import (AutoModelForSequenceClassification, AutoTokenizer,
                              get_linear_schedule_with_warmup)

    device = "cuda" if torch.cuda.is_available() else "cpu"
    use_amp = device == "cuda"
    cfg = MODEL_CFG.get(model_name, DEFAULT_CFG)
    tok = AutoTokenizer.from_pretrained(model_name)

    def encode(df):
        kws, texts = bert_input(df)
        enc = tok(kws, texts, truncation=True, max_length=MAX_LEN)
        return [{k: enc[k][i] for k in enc} for i in range(len(texts))]

    enc_train, enc_test = encode(train), encode(test)

    def make_loader(items, labels=None, shuffle=False):
        rows = [dict(it, labels=int(labels[i])) if labels is not None else dict(it)
                for i, it in enumerate(items)]
        return DataLoader(rows, batch_size=cfg["bs"], shuffle=shuffle,
                          collate_fn=lambda b: tok.pad(b, return_tensors="pt"))

    test_loader = make_loader(enc_test)
    loss_fn = torch.nn.CrossEntropyLoss(label_smoothing=LABEL_SMOOTHING)

    def make_scaler():
        try:
            return torch.amp.GradScaler("cuda", enabled=use_amp)
        except Exception:
            return torch.cuda.amp.GradScaler(enabled=use_amp)

    def train_fold(tr, va, fold_seed):
        set_seed(fold_seed)
        # .float(): некоторые чекпойнты (DeBERTa) грузятся в fp16 -> падает GradScaler
        model = AutoModelForSequenceClassification.from_pretrained(
            model_name, num_labels=2).float().to(device)
        tr_loader = make_loader([enc_train[i] for i in tr], y[tr], shuffle=True)
        va_loader = make_loader([enc_train[i] for i in va])
        opt = torch.optim.AdamW(model.parameters(), lr=cfg["lr"], weight_decay=0.01)
        total = len(tr_loader) * FT_EPOCHS
        sched = get_linear_schedule_with_warmup(opt, int(0.1 * total), total)
        scaler = make_scaler()
        for _epoch in range(FT_EPOCHS):
            model.train()
            for batch in tr_loader:
                batch = {k: v.to(device) for k, v in batch.items()}
                labels = batch.pop("labels")
                with torch.autocast(device_type="cuda", dtype=torch.float16, enabled=use_amp):
                    logits = model(**batch).logits
                loss = loss_fn(logits.float(), labels)
                opt.zero_grad()
                scaler.scale(loss).backward()
                scaler.unscale_(opt)
                torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)
                scaler.step(opt)
                scaler.update()
                sched.step()
        p_va = _predict_proba(model, va_loader, device, use_amp)
        p_te = _predict_proba(model, test_loader, device, use_amp)
        del model, opt, sched
        gc.collect()
        if use_amp:
            torch.cuda.empty_cache()
        return p_va, p_te

    oof = np.zeros(len(train))
    test_pred = np.zeros(len(test))
    for fold, (tr, va) in enumerate(SPLITTER.split(train, y)):
        t0 = time.time()
        for attempt in range(2):
            p_va, p_te = train_fold(tr, va, seed + fold + 777 * attempt)
            f1 = f1_score(y[va], (p_va >= 0.5).astype(int))
            if f1 >= MIN_FOLD_F1:
                break
            print(f"    фолд {fold + 1}: F1={f1:.3f} - обучение схлопнулось, повтор с другим зерном")
        oof[va] = p_va
        test_pred += p_te / N_FOLDS
        print(f"  [{model_name} seed={seed}] fold {fold + 1}: F1@0.5 = {f1:.4f} "
              f"({time.time() - t0:.0f} c)", flush=True)
    return oof, test_pred


def run_advanced(train, test, y):
    import torch
    default_mode = "finetune" if torch.cuda.is_available() else "features"
    mode = os.environ.get("MODE", default_mode)
    print(f"Режим трансформеров: {mode}")
    if mode == "features":
        o, t = run_bert_features(train, test, y)
        return [o], [t]

    oofs, tests = [], []
    for model_name in MODELS:
        for s in range(N_SEEDS):
            seed = SEED + 100 * s
            print(f"\n-- {model_name}, seed {seed} --", flush=True)
            try:
                oof, tp = run_finetune(model_name, train, test, y, seed)
            except Exception as e:
                print(f"  !! {model_name} пропущена: {type(e).__name__}: {e}")
                break
            report(f"{model_name} seed={seed}", y, oof)
            oofs.append(oof)
            tests.append(tp)
    if not oofs:
        raise RuntimeError("Ни одна модель не обучилась. Проверьте Internet=On и GPU.")
    return oofs, tests


# ----------------------------------------------------------------------------
# 6. Чистка шумных меток
# ----------------------------------------------------------------------------
def filter_noisy_labels(train, test, y):
    """Быстрый проход (базовая модель + одна трансформерная) и удаление строк,
    где предсказание сильнее всего расходится с меткой."""
    print("\n== Поиск шумных меток ==")
    oof_b, _ = run_baseline(train, test, y)
    oof_t, _ = run_finetune(NOISE_MODEL, train, test, y, SEED)
    avg = 0.5 * (oof_b + oof_t)
    err = np.abs(avg - y)
    n_drop = int(len(train) * CLEAN_FRAC)
    drop_idx = np.argsort(-err)[:n_drop]
    print(f"Удаляем {n_drop} строк с самым сильным расхождением (порог ошибки >= {err[drop_idx].min():.2f})")
    for i in drop_idx[:6]:
        print(f"   метка={y[i]} предсказание={avg[i]:.2f} | {train['text'].iloc[i][:90]}")
    keep = np.setdiff1d(np.arange(len(train)), drop_idx)
    return train.iloc[keep].reset_index(drop=True)


# ----------------------------------------------------------------------------
# 7. Ансамбль
# ----------------------------------------------------------------------------
def best_blend(y, oof_base, oof_adv):
    best = (0.0, 0.0, 0.0)
    for w in np.arange(0.0, 0.61, 0.1):
        t, f1 = find_best_threshold(y, w * oof_base + (1 - w) * oof_adv)
        if f1 > best[2]:
            best = (float(w), t, f1)
    return best


def _logit(p):
    p = np.clip(p, 1e-4, 1 - 1e-4)
    return np.log(p / (1 - p))


def stack_models(oof_list, test_list, y):
    Z = np.column_stack([_logit(o) for o in oof_list])
    Zt = np.column_stack([_logit(t) for t in test_list])
    meta = LogisticRegression(C=1.0, max_iter=1000)
    cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=SEED)
    oof_stack = cross_val_predict(meta, Z, y, cv=cv, method="predict_proba")[:, 1]
    meta.fit(Z, y)
    return oof_stack, meta.predict_proba(Zt)[:, 1]


def main():
    import torch
    train, test = load_data()
    train = remove_duplicates_and_leakage(train, test)
    train = prepare_tabular_features(train)
    test = prepare_tabular_features(test)
    for df in (train, test):
        df["text_basic"] = df["text"].map(clean_text_basic)
        df["text_min"] = df["text"].map(clean_text_minimal)
    FoldSplitter.groups = train["group"].to_numpy()
    y = train["target"].to_numpy()

    # --- чистка шумных меток (нужен GPU) ---
    if CLEAN_FRAC > 0 and torch.cuda.is_available() and os.environ.get("MODE") != "features":
        train = filter_noisy_labels(train, test, y)
        FoldSplitter.groups = train["group"].to_numpy()
        y = train["target"].to_numpy()
        print(f"После чистки: {len(train)} строк")

    print("\n== Базовая модель ==")
    oof_base, test_base = run_baseline(train, test, y)
    report("Базовая", y, oof_base)

    print("\n== Трансформеры ==")
    oofs_adv, tests_adv = run_advanced(train, test, y)
    oof_adv = np.mean(oofs_adv, axis=0)
    test_adv = np.mean(tests_adv, axis=0)
    report("Трансформеры (среднее)", y, oof_adv)

    w, thr_b, f1_b = best_blend(y, oof_base, oof_adv)
    oof_blend = w * oof_base + (1 - w) * oof_adv
    test_blend = w * test_base + (1 - w) * test_adv
    print(f"Среднее: вес базовой {w:.1f}")
    report("Ансамбль-среднее", y, oof_blend)

    oof_stack, test_stack = stack_models([oof_base] + oofs_adv, [test_base] + tests_adv, y)
    thr_s, f1_s = report("Ансамбль-стекинг", y, oof_stack)

    if f1_s >= f1_b:
        oof_ens, test_ens, thr, f1, name = oof_stack, test_stack, thr_s, f1_s, "стекинг"
    else:
        oof_ens, test_ens, thr, f1, name = oof_blend, test_blend, thr_b, f1_b, "среднее"
    acc = accuracy_score(y, (oof_ens >= thr).astype(int))
    print(f"\n>>> ИТОГ ({name}): порог {thr:.2f} | F1 = {f1:.4f} | accuracy = {acc:.4f}")

    pred = (test_ens >= thr).astype(int)

    # --- метки из train для дословно совпадающих тестовых твитов ---
    if OVERRIDE_DUP and DUP_MAP:
        ov = test["text"].map(normalize_for_dedup).map(DUP_MAP).to_numpy(dtype=float)
        m = ~np.isnan(ov)
        changed = int(np.sum(pred[m] != ov[m].astype(int)))
        pred[m] = ov[m].astype(int)
        print(f"Совпадений тестовых твитов с train: {int(m.sum())}, из них изменено: {changed}")

    sub = pd.DataFrame({"id": test["id"], "target": pred})
    sub.to_csv("submission.csv", index=False)
    print(f"Сохранено submission.csv ({len(sub)} строк), доля класса 1: {sub['target'].mean():.3f}")


if __name__ == "__main__":
    main()

