

"""
Kaggle Playground S4E8 (грибы) - быстрый пайплайн: XGBoost(GPU) + CatBoost(GPU) [+ LightGBM(CPU)].

Главные ускорения:
  * Надёжное определение GPU (nvidia-smi -L), с громким предупреждением, если GPU нет.
  * Категории -> pandas 'category' / целые коды, без apply и циклов по строкам.
  * squash_rare векторизован (value_counts + isin).
  * 3 фолда вместо 5, меньше деревьев, больший learning rate, early stopping.
  * Промежуточные результаты каждой модели сохраняются на диск (.npy).
  * Контроль бюджета времени: если время вышло, оставшиеся модели пропускаются.
  * Быстрый подбор весов ансамбля (по подвыборке) + подбор порога под MCC.

Настройки через переменные окружения: FOLDS, TIME_BUDGET_H, USE_LGBM=1, MIN_COUNT.
"""

import gc
import itertools
import os
import random
import subprocess
import time

import numpy as np
import pandas as pd
from sklearn.model_selection import StratifiedKFold

SEED = 42
N_FOLDS = int(os.environ.get("FOLDS", 3))
TIME_BUDGET_H = float(os.environ.get("TIME_BUDGET_H", 7.0))   # запас до лимита Kaggle
USE_LGBM = os.environ.get("USE_LGBM", "0") == "1"
MIN_COUNT = int(os.environ.get("MIN_COUNT", 50))              # редкие категории -> '__rare__'
OUT_DIR = "/kaggle/working" if os.path.isdir("/kaggle/working") else "."

START = time.time()
random.seed(SEED)
np.random.seed(SEED)


def elapsed_h() -> float:
    return (time.time() - START) / 3600


def log(msg: str) -> None:
    print(f"[{elapsed_h() * 60:6.1f} мин] {msg}", flush=True)


# ----------------------------------------------------------------------------
# GPU: shutil.which("nvidia-smi") ненадёжен, проверяем реальный вызов
# ----------------------------------------------------------------------------
def detect_gpu() -> bool:
    try:
        r = subprocess.run(["nvidia-smi", "-L"], capture_output=True, text=True, timeout=15)
        return r.returncode == 0 and "GPU" in r.stdout
    except Exception:
        return False


HAS_GPU = detect_gpu()
if HAS_GPU:
    print("GPU найден:", subprocess.run(["nvidia-smi", "-L"], capture_output=True,
                                         text=True).stdout.strip())
else:
    print("!" * 70)
    print("GPU НЕ НАЙДЕН. Справа: Settings -> Accelerator -> GPU T4 x2 (или P100),")
    print("затем перезапустите сессию. Без GPU код будет в разы медленнее.")
    print("!" * 70)


# ----------------------------------------------------------------------------
# Загрузка
# ----------------------------------------------------------------------------
def find_competition_dir() -> str:
    for root, _d, files in os.walk("/kaggle/input"):
        if "train.csv" in files and "test.csv" in files:
            return root
    if os.path.exists("train.csv"):
        return "."
    raise FileNotFoundError("train.csv не найден")


def find_file(name: str):
    for root, _d, files in os.walk("/kaggle/input"):
        if name in files:
            return os.path.join(root, name)
    return None


def norm_cols(df: pd.DataFrame) -> pd.DataFrame:
    df.columns = df.columns.str.replace("-", "_", regex=False)
    return df


def load_data():
    d = find_competition_dir()
    train = norm_cols(pd.read_csv(os.path.join(d, "train.csv")))
    test = norm_cols(pd.read_csv(os.path.join(d, "test.csv")))
    sample = pd.read_csv(os.path.join(d, "sample_submission.csv"))

    # Оригинальный датасет UCI (если добавлен в ноутбук) - даёт дополнительные данные
    orig_path = find_file("secondary_data.csv")
    if orig_path:
        orig = norm_cols(pd.read_csv(orig_path, sep=";"))
        orig = orig[[c for c in train.columns if c in orig.columns]].copy()
        orig["id"] = -1
        train = pd.concat([train, orig], ignore_index=True)
        log(f"Добавлен secondary_data.csv: +{len(orig)} строк")
    else:
        log("secondary_data.csv не найден - работаем без него")
    log(f"train: {train.shape} | test: {test.shape}")
    return train, test, sample


# ----------------------------------------------------------------------------
# Признаки: векторизованно, без apply
# ----------------------------------------------------------------------------
def squash_rare_to_codes(s: pd.Series, min_count: int) -> pd.Categorical:
    """Редкие значения -> '__rare__', пропуски -> '__nan__'. Всё через value_counts/isin."""
    s = s.astype("object")
    s = s.where(s.notna(), "__nan__")
    vc = s.value_counts()
    rare = vc.index[vc < min_count]
    if len(rare):
        s = s.where(~s.isin(rare), "__rare__")
    codes, uniques = pd.factorize(s, sort=True)
    return pd.Categorical.from_codes(codes, categories=uniques)


def build_features(train: pd.DataFrame, test: pd.DataFrame):
    n_tr = len(train)
    feats = pd.concat([train.drop(columns=["id", "class"], errors="ignore"),
                       test.drop(columns=["id"], errors="ignore")], ignore_index=True)

    num_cols = [c for c in ["cap_diameter", "stem_height", "stem_width"] if c in feats.columns]
    cat_cols = [c for c in feats.columns if c not in num_cols]

    for c in num_cols:
        feats[c] = pd.to_numeric(feats[c], errors="coerce").astype("float32")
    for c in cat_cols:
        feats[c] = squash_rare_to_codes(feats[c], MIN_COUNT)
    log(f"числовых: {len(num_cols)} | категориальных: {len(cat_cols)}")

    # Несколько дешёвых производных признаков (формы гриба)
    eps = 1e-3
    feats["stem_ratio"] = (feats["stem_height"] / (feats["stem_width"] + eps)).astype("float32")
    feats["cap_stem_ratio"] = (feats["cap_diameter"] / (feats["stem_width"] + eps)).astype("float32")
    feats["cap_x_stem_h"] = (feats["cap_diameter"] * feats["stem_height"]).astype("float32")

    X = feats.iloc[:n_tr].reset_index(drop=True)
    Xte = feats.iloc[n_tr:].reset_index(drop=True)
    y = (train["class"].to_numpy() == "p").astype(np.int8)
    return X, Xte, y, cat_cols


def to_int_codes(X: pd.DataFrame, cat_cols) -> pd.DataFrame:
    """Для CatBoost: категории -> int32 коды (быстрее, чем строки)."""
    X = X.copy()
    for c in cat_cols:
        X[c] = X[c].cat.codes.astype("int32")
    return X


# ----------------------------------------------------------------------------
# Метрика MCC на numpy (быстро)
# ----------------------------------------------------------------------------
def mcc_score(y, pred) -> float:
    y = y.astype(bool)
    pred = pred.astype(bool)
    tp = float(np.sum(pred & y))
    tn = float(np.sum(~pred & ~y))
    fp = float(np.sum(pred & ~y))
    fn = float(np.sum(~pred & y))
    den = np.sqrt((tp + fp) * (tp + fn) * (tn + fp) * (tn + fn))
    return (tp * tn - fp * fn) / den if den > 0 else 0.0


# ----------------------------------------------------------------------------
# Модели
# ----------------------------------------------------------------------------
def save_preds(name, oof, test_pred):
    np.save(os.path.join(OUT_DIR, f"oof_{name}.npy"), oof)
    np.save(os.path.join(OUT_DIR, f"test_{name}.npy"), test_pred)


def run_xgb(X, y, Xte, folds):
    import xgboost as xgb
    params = dict(
        objective="binary:logistic", eval_metric="logloss",
        tree_method="hist", device="cuda" if HAS_GPU else "cpu",
        learning_rate=0.08, max_depth=10, min_child_weight=5,
        subsample=0.8, colsample_bytree=0.7, reg_lambda=2.0,
        max_bin=256, seed=SEED,
    )
    dte = xgb.DMatrix(Xte, enable_categorical=True)
    oof = np.zeros(len(X), dtype=np.float32)
    tp = np.zeros(len(Xte), dtype=np.float32)
    for i, (tr, va) in enumerate(folds):
        t0 = time.time()
        dtr = xgb.QuantileDMatrix(X.iloc[tr], label=y[tr], enable_categorical=True,
                                  max_bin=params["max_bin"])
        dva = xgb.QuantileDMatrix(X.iloc[va], label=y[va], enable_categorical=True,
                                  ref=dtr)
        booster = xgb.train(params, dtr, num_boost_round=2500, evals=[(dva, "val")],
                            early_stopping_rounds=100, verbose_eval=False)
        rng = (0, booster.best_iteration + 1)
        oof[va] = booster.predict(dva, iteration_range=rng)
        tp += booster.predict(dte, iteration_range=rng) / len(folds)
        log(f"[XGB] fold {i + 1}/{len(folds)} MCC={mcc_score(y[va], oof[va] >= 0.5):.5f} "
            f"деревьев={booster.best_iteration + 1} ({time.time() - t0:.0f} c)")
        del dtr, dva, booster
        gc.collect()
    return oof, tp


def run_cat(X_cb, y, Xte_cb, cat_cols, folds):
    from catboost import CatBoostClassifier, Pool
    cat_idx = [X_cb.columns.get_loc(c) for c in cat_cols]
    pte = Pool(Xte_cb, cat_features=cat_idx)
    oof = np.zeros(len(X_cb), dtype=np.float32)
    tp = np.zeros(len(Xte_cb), dtype=np.float32)
    for i, (tr, va) in enumerate(folds):
        t0 = time.time()
        ptr = Pool(X_cb.iloc[tr], y[tr], cat_features=cat_idx)
        pva = Pool(X_cb.iloc[va], y[va], cat_features=cat_idx)
        model = CatBoostClassifier(
            iterations=2500, learning_rate=0.15, depth=7, l2_leaf_reg=3.0,
            border_count=128, loss_function="Logloss",
            task_type="GPU" if HAS_GPU else "CPU", devices="0" if HAS_GPU else None,
            random_seed=SEED, od_type="Iter", od_wait=100, verbose=0,
            thread_count=-1,
        )
        model.fit(ptr, eval_set=pva, use_best_model=True)
        oof[va] = model.predict_proba(pva)[:, 1]
        tp += model.predict_proba(pte)[:, 1] / len(folds)
        log(f"[CAT] fold {i + 1}/{len(folds)} MCC={mcc_score(y[va], oof[va] >= 0.5):.5f} "
            f"деревьев={model.get_best_iteration() + 1} ({time.time() - t0:.0f} c)")
        del ptr, pva, model
        gc.collect()
    return oof, tp


def run_lgb(X, y, Xte, folds):
    """LightGBM на CPU (pip-версия на Kaggle обычно без GPU). По умолчанию выключен."""
    import lightgbm as lgb
    params = dict(
        objective="binary", learning_rate=0.1, num_leaves=128, max_bin=127,
        min_data_in_leaf=50, feature_fraction=0.7, bagging_fraction=0.8, bagging_freq=1,
        lambda_l2=2.0, verbose=-1, num_threads=os.cpu_count(), seed=SEED,
    )
    oof = np.zeros(len(X), dtype=np.float32)
    tp = np.zeros(len(Xte), dtype=np.float32)
    for i, (tr, va) in enumerate(folds):
        t0 = time.time()
        dtr = lgb.Dataset(X.iloc[tr], y[tr])
        dva = lgb.Dataset(X.iloc[va], y[va], reference=dtr)
        m = lgb.train(params, dtr, num_boost_round=2000, valid_sets=[dva],
                      callbacks=[lgb.early_stopping(100, verbose=False)])
        oof[va] = m.predict(X.iloc[va], num_iteration=m.best_iteration)
        tp += m.predict(Xte, num_iteration=m.best_iteration) / len(folds)
        log(f"[LGB] fold {i + 1}/{len(folds)} MCC={mcc_score(y[va], oof[va] >= 0.5):.5f} "
            f"({time.time() - t0:.0f} c)")
        del dtr, dva, m
        gc.collect()
    return oof, tp


# ----------------------------------------------------------------------------
# Ансамбль: веса и порог под MCC
# ----------------------------------------------------------------------------
def find_blend(y, oofs):
    n = len(oofs)
    if n == 1:
        return [1.0]
    rng = np.random.RandomState(SEED)
    idx = rng.choice(len(y), size=min(500_000, len(y)), replace=False)   # подвыборка для скорости
    best_w, best = None, -1.0
    for combo in itertools.product(range(11), repeat=n):
        if sum(combo) != 10:
            continue
        w = np.array(combo) / 10.0
        p = sum(wi * o[idx] for wi, o in zip(w, oofs))
        s = mcc_score(y[idx], p >= 0.5)
        if s > best:
            best, best_w = s, w
    return list(best_w)


def find_threshold(y, p):
    grid = np.arange(0.30, 0.71, 0.01)
    scores = [mcc_score(y, p >= t) for t in grid]
    i = int(np.argmax(scores))
    return float(grid[i]), float(scores[i])


# ----------------------------------------------------------------------------
def main():
    train, test, sample = load_data()
    X, Xte, y, cat_cols = build_features(train, test)
    del train, test
    gc.collect()
    log(f"признаков: {X.shape[1]}")

    folds = list(StratifiedKFold(n_splits=N_FOLDS, shuffle=True, random_state=SEED).split(X, y))

    results = {}   # имя -> (oof, test_pred)
    jobs = ["xgb", "cat"] + (["lgb"] if USE_LGBM else [])
    for name in jobs:
        if elapsed_h() > TIME_BUDGET_H:
            log(f"Бюджет времени исчерпан, пропускаем {name}")
            continue
        log(f"=== {name.upper()} ===")
        try:
            if name == "xgb":
                oof, tp = run_xgb(X, y, Xte, folds)
            elif name == "cat":
                oof, tp = run_cat(to_int_codes(X, cat_cols), y, to_int_codes(Xte, cat_cols),
                                  cat_cols, folds)
            else:
                oof, tp = run_lgb(X, y, Xte, folds)
        except Exception as e:
            log(f"!! {name} упала: {type(e).__name__}: {e}")
            continue
        results[name] = (oof, tp)
        save_preds(name, oof, tp)
        log(f"{name.upper()} OOF MCC (порог 0.5) = {mcc_score(y, oof >= 0.5):.5f}")

    if not results:
        raise RuntimeError("Ни одна модель не обучилась")

    names = list(results)
    oofs = [results[n][0] for n in names]
    tests = [results[n][1] for n in names]
    w = find_blend(y, oofs)
    log("Веса ансамбля: " + ", ".join(f"{n}={wi:.1f}" for n, wi in zip(names, w)))
    oof_blend = sum(wi * o for wi, o in zip(w, oofs))
    test_blend = sum(wi * t for wi, t in zip(w, tests))
    thr, score = find_threshold(y, oof_blend)
    log(f"ИТОГ: порог {thr:.2f} | OOF MCC = {score:.5f}")

    sub = sample.copy()
    sub["class"] = np.where(test_blend >= thr, "p", "e")
    sub.to_csv("submission.csv", index=False)
    log(f"submission.csv сохранён ({len(sub)} строк), доля 'p': {(sub['class'] == 'p').mean():.3f}")


if __name__ == "__main__":
    main()


